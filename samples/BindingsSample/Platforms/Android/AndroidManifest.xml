<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- SDK manifests also set allowBackup and label; tools:replace lets this app's values win the merge. -->
  <application android:allowBackup="false" android:supportsRtl="true" tools:replace="android:allowBackup,android:label">

    <!-- Facebook SDK -->
    <activity android:name="com.facebook.FacebookActivity"
              android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
              android:label="@string/app_name" />
    <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id" />
    <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token" />

    <!-- CCAvenue SDK: its activities need an AppCompat theme, supplied in styles.xml -->
    <activity android:name="com.ccavenue.indiasdk.PayOptionsActivity"
              android:screenOrientation="portrait"
              android:stateNotNeeded="true"
              android:theme="@style/CCAvenueSdkTheme"
              android:windowSoftInputMode="adjustResize"
              tools:replace="android:theme,android:screenOrientation,android:stateNotNeeded,android:windowSoftInputMode" />
    <activity android:name="com.ccavenue.indiasdk.WebViewActivity"
              android:screenOrientation="portrait"
              android:stateNotNeeded="true"
              android:theme="@style/CCAvenueSdkTheme"
              android:windowSoftInputMode="adjustResize"
              tools:replace="android:theme,android:screenOrientation,android:stateNotNeeded,android:windowSoftInputMode" />
  </application>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>
